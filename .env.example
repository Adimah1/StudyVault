# StudyVault AI configuration (Google Gemini).
# Copy this file to .env and put your key in it BEFORE running `npm run dist`.
# The .env file is bundled into the installer, so students never need to enter a key.
# Get a key at https://aistudio.google.com/apikey

GEMINI_API_KEY=YOUR_KEY_HERE

# Optional: override the model (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
